# Production environment (Railway) — fundXI backend.
# Copy these as service variables in Railway. Do NOT commit real secrets.
# Replace <your-domain> with the domain you bought (e.g. fundxi.app).

# Anything other than "dev" => secure (HTTPS-only) cookies + JWT-secret guard.
APP_ENV=production

# Postgres — Railway's managed Postgres injects DATABASE_URL automatically.
# It hands out a postgresql:// URL; SQLAlchemy async needs the +asyncpg driver.
# Use Railway's reference and rewrite the scheme:
#   DATABASE_URL=postgresql+asyncpg://...   (point it at ${{Postgres.DATABASE_URL}} then swap the scheme)

# JWT signing secret — MUST be strong and secret (boot fails on the dev default
# when APP_ENV != dev). NEVER commit the real value; set it directly in the
# Railway dashboard. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<paste-a-generated-secret-in-railway-not-here>

# Starter cash (€M) granted to a new portfolio.
INITIAL_CASH=100.0

# Sportmonks data provider.
SPORTMONKS_API_TOKEN=
SPORTMONKS_BASE_URL=https://api.sportmonks.com/v3/football
ACTIVE_SEASON_ID=0

# CORS — allow the web origin AND the streaming origin to call the API.
# Since the SPA is served by this same app it's same-origin, but list the
# apex/www explicitly to be safe.
CORS_ALLOW_ORIGINS=https://<your-domain>,https://www.<your-domain>

# --- Password-reset email (Resend) ---
# Real emails send when APP_ENV != dev AND a key is present. The sender domain
# must be verified in Resend (DNS records added to <your-domain>).
RESEND_API_KEY=
EMAIL_FROM=fundXI <no-reply@<your-domain>>
# Public origin used to build the reset link in the email.
APP_BASE_URL=https://<your-domain>

LOG_LEVEL=INFO

# --- Error tracking (Sentry) ---
# Empty ⇒ Sentry disabled (no-op). Set the DSN from your Sentry project to
# enable error reporting in prod. Errors only — no perf trace sampling.
SENTRY_DSN=

# --- STREAMING WORKER service only (separate Railway service) ---
# The worker reads STREAM_*-prefixed vars (pydantic-settings env_prefix).
# NATS lives on its own internal Railway service; use private networking.
#   STREAM_NATS_SERVERS=nats://<nats-service-private-host>:4222
# The browser's EventSource hits the worker cross-origin, so allow the web
# origin here (CORS).
#   STREAM_CORS_ORIGIN=https://<your-domain>
# The API service does NOT need NATS or these STREAM_ vars.

# --- INGEST DAEMON service only (separate Railway service) ---
# Polls Sportmonks inplay during matches, publishes price ticks to NATS.
# Needs the Sportmonks vars above + DB + NATS (INGEST_-prefixed):
#   SPORTMONKS_API_TOKEN=...   (paid token with livescores/inplay)
#   ACTIVE_SEASON_ID=<WC2026 season id>
#   DATABASE_URL=postgresql+asyncpg://...   (same DB as the api)
#   INGEST_NATS_SERVERS=nats://<nats-service-private-host>:4222
# Optional cadence: INGEST_INPLAY_POLL_SECONDS, INGEST_NEWS_POLL_SECONDS, ...
