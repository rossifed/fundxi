# Database (used by both docker-compose and the app)
POSTGRES_USER=fundxi
POSTGRES_PASSWORD=fundxi
POSTGRES_DB=fundxi
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy / Alembic URL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://fundxi:fundxi@localhost:5432/fundxi

# Sportmonks
SPORTMONKS_API_TOKEN=
SPORTMONKS_BASE_URL=https://api.sportmonks.com/v3/football
# Sportmonks season_id of the season we currently ingest.
# WC2022 (Qatar) during dev, WC2026 once the tournament starts. Same pipeline.
ACTIVE_SEASON_ID=0

# Cash (in €M) granted to a brand-new portfolio at user creation.
# No default — must be set explicitly. Reasonable starter: 100.0
INITIAL_CASH=100.0

# App
LOG_LEVEL=INFO

# Password-reset flow.
# RESEND_API_KEY empty (or APP_ENV=dev) => reset emails are logged to the
# console instead of sent, so the link is visible in the API logs without an
# email account. Set a real Resend key in production.
RESEND_API_KEY=
# Verified sender address registered with Resend.
EMAIL_FROM=fundXI <no-reply@fundxi.local>
# Public origin used to build the reset link ({APP_BASE_URL}/reset-password?token=...).
APP_BASE_URL=http://localhost:5173
# Reset-token lifetime in seconds (default 3600 = 1 hour).
PASSWORD_RESET_TTL_SECONDS=3600
